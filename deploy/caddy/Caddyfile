# Ingresso di Argo dietro il proxy principale della VPS (deploy/proxy), che fa l'HTTPS:
# qui solo HTTP sulla rete Docker `proxy`.
{
	servers {
		# Il proxy principale è sulla rete privata Docker: se ne accettano X-Forwarded-For/Proto.
		# shortcut: anche le altre app sulla rete `proxy` sono "fidate", e potrebbero falsificare
		# l'IP visto dal limite di richieste; se serve, una rete dedicata tra proxy e Argo.
		trusted_proxies static private_ranges
	}
}

http://{$ARGO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		# Un solo IP, quello del client: l'API usa l'ultima voce (core/ratelimit.py).
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Dashboard: file statici compilati, fallback a index.html per le route del client.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

http://{$ARGO_AUTH_DOMAIN} {
	encode zstd gzip
	header -Server
	# La console e l'Admin API di Keycloak non sono esposte su Internet:
	# il backend li raggiunge sulla rete interna (http://keycloak:8080).
	@admin path /admin /admin/*
	respond @admin 404
	reverse_proxy keycloak:8080
}
