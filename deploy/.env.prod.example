# Copia in deploy/.env.prod sulla VPS (mai nel repository) e compila.
# Genera i segreti con: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ARGO_DOMAIN=argo.azienda.it
ARGO_AUTH_DOMAIN=accesso.azienda.it

POSTGRES_USER=argo
POSTGRES_PASSWORD=
# Ruolo usato da API e worker (non proprietario dello schema)
ARGO_APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
ARGO_BACKEND_CLIENT_SECRET=
ARGO_DASHBOARD_CLIENT_SECRET=
# Chiave Fernet per i segreti delle applicazioni:
# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ARGO_SECRETS_KEY=
ARGO_MASS_DEACTIVATION_THRESHOLD=3
# false fino al go-live: account creati senza inviti; poi `python -m app.cli send-invites`
ARGO_SEND_INVITES=true

# SMTP per gli inviti passkey. Mailpit è solo per lo sviluppo (cattura, non spedisce).
# Microsoft 365: smtp.office365.com:587, STARTTLS, autenticazione OAuth2 (la password
# semplice è stata ritirata da Microsoft). Vedi DEPLOYMENT.md, sezione Email.
ARGO_SMTP_HOST=
ARGO_SMTP_PORT=587
ARGO_SMTP_FROM=argo@azienda.it
ARGO_SMTP_AUTH=true
ARGO_SMTP_USER=
ARGO_SMTP_PASSWORD=
ARGO_SMTP_STARTTLS=true
# basic = utente/password; token = OAuth2 client credentials (Microsoft 365)
ARGO_SMTP_AUTH_TYPE=basic
ARGO_SMTP_TOKEN_URL=
ARGO_SMTP_TOKEN_SCOPE=
ARGO_SMTP_TOKEN_CLIENT_ID=
ARGO_SMTP_TOKEN_CLIENT_SECRET=

# Backup (deploy/backup.sh): passphrase di cifratura, conservata FUORI dalla VPS.
ARGO_BACKUP_PASSPHRASE=
