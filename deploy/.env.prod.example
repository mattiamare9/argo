# Copia in deploy/.env.prod sulla VPS (mai nel repository) e compila.
# Genera i segreti con: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ARGO_DOMAIN=argo.azienda.it
ARGO_AUTH_DOMAIN=accesso.azienda.it
ARGO_ACME_EMAIL=it@azienda.it

POSTGRES_USER=argo
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
ARGO_BACKEND_CLIENT_SECRET=
ARGO_DASHBOARD_CLIENT_SECRET=
# Chiave Fernet per i segreti delle applicazioni:
# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ARGO_SECRETS_KEY=
ARGO_MASS_DEACTIVATION_THRESHOLD=3

# SMTP per gli inviti passkey (provider da decidere: vedi docs, decisione aperta).
ARGO_SMTP_HOST=
ARGO_SMTP_PORT=587
ARGO_SMTP_FROM=argo@azienda.it
ARGO_SMTP_AUTH=true
ARGO_SMTP_USER=
ARGO_SMTP_PASSWORD=
ARGO_SMTP_STARTTLS=true

# Backup (deploy/backup.sh): passphrase di cifratura, conservata FUORI dalla VPS.
ARGO_BACKUP_PASSPHRASE=
