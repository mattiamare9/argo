ARGO_ENVIRONMENT=development
ARGO_DATABASE_URL=postgresql+asyncpg://argo:cambia-questa-password@127.0.0.1:5432/iam_db
# Usato da pytest: database dedicato, svuotato dai test.
ARGO_TEST_DATABASE_URL=postgresql+asyncpg://argo:cambia-questa-password@127.0.0.1:5432/iam_test
ARGO_LOG_LEVEL=INFO

# Keycloak: stessi segreti di deploy/.env
ARGO_KEYCLOAK_BACKEND_CLIENT_SECRET=cambia-questo-segreto
ARGO_OIDC_CLIENT_SECRET=cambia-questo-segreto
# Facoltativo: abilita i test di integrazione contro Keycloak
# ARGO_TEST_KEYCLOAK_URL=http://127.0.0.1:8080
